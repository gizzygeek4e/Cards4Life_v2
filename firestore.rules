rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{familyId} {
      allow read, write: if familyId.size() > 0 && familyId.size() <= 64;

      match /{allSubcollections=**} {
        allow read, write: if familyId.size() > 0 && familyId.size() <= 64;
      }
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
